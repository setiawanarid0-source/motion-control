# Copy to .env on the Oracle VM, never commit .env.
# Copy from the existing Railway production service using an authenticated admin session.
APP_MASTER_KEY=
RUNNINGHUB_WORKFLOW_ID=
# Optional: dedicated RunningHub H3 workflow ID, if you register one.
RUNNINGHUB_H3_WORKFLOW_ID=
# The DNS A record must already point to the Oracle VM public IPv4.
VANTA_DOMAIN=
VANTA_WEB_RELEASE=oracle-v1
